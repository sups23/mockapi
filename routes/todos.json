{
    "/api/todos/stats": {
        "GET": {
            "file": "api/todos/scenarios/{{activeScenario}}/mocks/stats.json",
            "status": 200
        }
    },
    "/api/todos/tips": {
        "GET": {
            "file": "api/todos/scenarios/{{activeScenario}}/mocks/tips.json",
            "status": 200
        }
    },
    "/api/todos/{slug}/preview": {
        "GET": {
            "file": "api/todos/scenarios/{{activeScenario}}/mocks/preview.json",
            "status": 200,
            "headers": {
                "X-Sample-Route": "todos-preview"
            }
        }
    }
}
